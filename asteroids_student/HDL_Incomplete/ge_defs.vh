`define GE_HDR_WORDS           10
`define GE_OBJ_WORDS           3
`define GE_N_PAL               16
`define GE_OBJ_BITS            96
`define GE_MAGIC               8'hA5

// Directory entry (1 word)
`define GDIR_HDR_ADDR          10:0    // ROM address of the game's header word H0
`define GDIR_VERSION           23:16   // format version, must be 2
`define GDIR_VALID             31      // 1 = slot holds a game; 0 = loader ignores the request

// Game header (10 words)
`define H0_N_RULE              7:0     // number of rule records, 0..32
`define H0_N_INP               15:8    // number of input-mapping records, 0..32
`define H0_N_OBJ               23:16   // number of object records, 0..64
`define H0_MAGIC               31:24   // 0xA5; the loader aborts on any other value
`define H1_OBJ_BASE            10:0    // ROM address of object record 0, word 0
`define H1_INP_BASE            26:16   // ROM address of input-mapping record 0
`define H2_RULE_BASE           10:0    // ROM address of rule record 0, word 0
`define H2_PAL_BASE            26:16   // ROM address of palette entry 0
`define H3_XMIN                10:0    // signed. arena left edge, inclusive, pixels
`define H3_XMAX                26:16   // signed. arena right edge, exclusive, pixels
`define H4_YMIN                10:0    // signed. arena top edge, inclusive, pixels
`define H4_YMAX                26:16   // signed. arena bottom edge, exclusive, pixels
`define H5_WIN_SCORE           6:0     // a player wins when score >= this; 0 disables
`define H5_INIT_SCORE          14:8    // both scores are set to this at load
`define H5_LOSE_AT_ZERO        16      // 1 = a player whose lives counter is 0 loses
`define H5_SPIN_STEP           22:20   // SPIN velocity increment, pixels/frame
`define H5_SPIN_MAX            28:24   // SPIN clamp, |v| <= spin_max
`define H6_HUD_P1_X            9:0     // screen x of player 1 score digits
`define H6_HUD_P2_X            19:10   // screen x of player 2 score digits
`define H6_HUD_Y               28:20   // screen y of both score displays
`define H6_HUD_EN              31      // 1 = draw on-screen scores
`define H7_COLLIDER_MASK       15:0    // bit c = class c is evaluated as SELF of collisions
`define H7_CONTROLLED_MASK     31:16   // bit c = class c has its velocity zeroed every frame
`define H8_INIT_LIVES          3:0     // both lives counters are set to this at load, 0..9; 0 = no lives display
`define H8_MARK_COLOR          11:8    // palette index of the facing marker
`define H8_WAVE_WATCH          31:16   // bit c = class c is watched; 0 disables the wave reload
`define H9_WAVE_RELOAD         15:0    // bit c = class c is reloaded when no watched object is left

// Object record (3 words)
`define OBJ_X                  10:0    // signed. left edge, pixels (screen x; may be off screen)
`define OBJ_Y                  21:11   // signed. top edge, pixels
`define OBJ_W                  31:22   // width, pixels, 1..1023
`define OBJ_H                  41:32   // height, pixels, 1..1023
`define OBJ_VX                 47:42   // signed. x velocity, pixels/frame, -31..31
`define OBJ_VY                 53:48   // signed. y velocity, pixels/frame, -31..31
`define OBJ_COLOR              57:54   // palette index; 0 = invisible
`define OBJ_CLASS              61:58   // object class, matched by rules and input mappings
`define OBJ_OWNER              63:62   // 0 none, 1 player 1, 2 player 2
`define OBJ_ENABLED            64      // 1 = object exists
`define OBJ_BMODE              66:65   // arena boundary mode: 0 CLAMP 1 BOUNCE 2 WRAP 3 DESTROY
`define OBJ_TMODE              68:67   // timer mode: 0 COUNTDOWN 1 FREEZE 2 LIFETIME 3 SHIELD
`define OBJ_DIR                71:69   // heading: 0 E 1 NE 2 N 3 NW 4 W 5 SW 6 S 7 SE
`define OBJ_HP                 75:72   // hit points used by the DAMAGE fate
`define OBJ_TIMER              83:76   // frames; decremented every update while non-zero
`define OBJ_MARK               84      // 1 = draw a 4 x 4 facing marker inside the object
`define OBJ_COOL               89:85   // SPAWN cooldown, frames; decremented every update while non-zero

// Input-mapping record (1 word)
`define INP_PARAM              15:0    // operation parameter, see MOVE / SPAWN layouts
`define INP_CLASS              19:16   // target class
`define INP_OWNER              21:20   // target owner: 0 any, 1 player 1, 2 player 2
`define INP_TRIGGER            23:22   // 0 HELD, 1 PRESSED
`define INP_BUTTON             27:24   // logical button 0..9
`define INP_OP                 31:28   // 1 MOVE, 2 SPAWN

// MOVE parameter (INP.param) (1 word)
`define MOVE_DIR               1:0     // 0 RIGHT 1 LEFT 2 DOWN 3 UP
`define MOVE_SET_FACING        2       // 1 = afterwards point the heading along the velocity
`define MOVE_SPEED             9:4     // pixels/frame, 0..31

// SPAWN parameter (INP.param) (1 word)
`define SPAWN_POOL             3:0     // class of the pooled object to activate
`define SPAWN_COOLDOWN         15:8    // frames written to the spawner's cool field, 0..31

// Rule record (2 words)
`define R0_LAST                0       // 1 = stop scanning rules for this event after this rule fires
`define R0_OWNER_REL           17:16   // COLLIDE only: 0 ANY, 1 SAME owner, 2 DIFFERENT owner
`define R0_OTHER               23:20   // COLLIDE: other class. EDGE: edge mask {B,T,R,L}
`define R0_SELF                27:24   // class of the object the event belongs to
`define R0_EVENT               31:28   // 0 COLLIDE, 1 EDGE
`define R1_MOTION              1:0     // self motion response: 0 NONE 1 BOUNCE 2 STOP
`define R1_SPIN                2       // with BOUNCE: nudge perpendicular velocity by other's motion
`define R1_COPY_OWNER          3       // self.owner := other.owner
`define R1_COPY_COLOR          4       // self.color := other.color
`define R1_COUNTER             5       // 0 = change the score, 1 = change the lives counter
`define R1_SCORE_SEL           10:8    // which player's counter changes
`define R1_SCORE_DELTA         15:12   // signed. signed change, -8..7; score saturates 0..99, lives 0..9
`define R1_SELF_FATE           18:16   // 0 NONE 1 DAMAGE 2 DESTROY 3 RESPAWN
`define R1_OTHER_FATE          21:19   // 0 NONE 1 DAMAGE 2 DESTROY 3 RESPAWN 4 SPLIT
`define R1_FLIP_X              22      // self RESPAWN: negate the reloaded vx
`define R1_FLIP_Y              23      // self RESPAWN: negate the reloaded vy
`define R1_SPLIT_CLASS         27:24   // SPLIT: class of the pooled fragments

// Palette entry (1 word)
`define PAL_RGB                11:0    // {R[3:0], G[3:0], B[3:0]}

