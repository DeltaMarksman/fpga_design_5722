//
// Naming: <RECORD>_<FIELD> is a bit range you can use as  word[`NAME].
// For multi-word records the range indexes the whole record with word 0 in
// the least significant 32 bits (an object record is {W2, W1, W0} = 96 bits).
`ifndef GE_DEFS_VH
`define GE_DEFS_VH

`define GE_ROM_AW              11
`define GE_MAX_OBJ             64
`define GE_MAX_INP             32
