     "repeat": {"nx": 3, "ny": 1, "dx": 0, "dy": 0}},
    {"//": "the wave: three large rocks near the edges, reloaded from here when the field is clear",
     "name": "big0", "class": "ROCK_L", "x": 40,  "y": 40,  "w": 32, "h": 32, "vx": 2,  "vy": 1,
     "color": "rock_l", "bmode": "WRAP"},
    {"name": "big1", "class": "ROCK_L", "x": 560, "y": 60,  "w": 32, "h": 32, "vx": -1, "vy": 2,
