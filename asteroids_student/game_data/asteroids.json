    {"//": "fragment pools: exactly enough for every rock to split all the way down",
     "name": "mid", "class": "ROCK_M", "pool": true, "x": 0, "y": 0, "w": 16, "h": 16, "vx": 1,
     "color": "rock_m", "bmode": "WRAP", "repeat": {"nx": 6, "ny": 1, "dx": 0, "dy": 0}},
    {"name": "small", "class": "ROCK_S", "pool": true, "x": 0, "y": 0, "w": 8, "h": 8, "vx": 1,
