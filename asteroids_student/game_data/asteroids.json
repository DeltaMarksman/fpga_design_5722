     "vx": 6, "color": "shot1", "bmode": "WRAP", "tmode": "LIFETIME", "timer": 45,
     "repeat": {"nx": 3, "ny": 1, "dx": 0, "dy": 0}},
    {"name": "p2_shot", "class": "SHOT", "owner": "P2", "pool": true, "x": 0, "y": 0, "w": 4, "h": 4,
