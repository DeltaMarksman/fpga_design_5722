    {"button": "P1_LEFT",  "class": "SHIP", "owner": "P1", "op": "MOVE", "dir": "LEFT",  "speed": 3, "set_facing": true},
    {"button": "P1_RIGHT", "class": "SHIP", "owner": "P1", "op": "MOVE", "dir": "RIGHT", "speed": 3, "set_facing": true},
