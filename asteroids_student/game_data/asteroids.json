     "color": "p1", "dir": "E", "mark": true, "bmode": "WRAP", "tmode": "SHIELD", "timer": 60},
    {"name": "p2_ship", "class": "SHIP", "owner": "P2", "x": 426, "y": 233, "w": 14, "h": 14,
