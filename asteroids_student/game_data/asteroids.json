    {"button": "P2_UP",    "class": "SHIP", "owner": "P2", "op": "MOVE", "dir": "UP",    "speed": 3, "set_facing": true},
    {"button": "P2_DOWN",  "class": "SHIP", "owner": "P2", "op": "MOVE", "dir": "DOWN",  "speed": 3, "set_facing": true},
    {"button": "P2_LEFT",  "class": "SHIP", "owner": "P2", "op": "MOVE", "dir": "LEFT",  "speed": 3, "set_facing": true},
    {"button": "P2_RIGHT", "class": "SHIP", "owner": "P2", "op": "MOVE", "dir": "RIGHT", "speed": 3, "set_facing": true},
    {"button": "P2_ACT",   "trigger": "PRESSED", "class": "SHIP", "owner": "P2", "op": "SPAWN", "pool": "SHOT", "cooldown": 8}
  ],
  "rules": [
    {"//": "shot hits rock: the rock breaks into two smaller ones (the smallest just vanish)",
     "event": "COLLIDE", "self": "SHOT", "other": "ROCK_L", "self_fate": "DESTROY",
     "other_fate": "SPLIT", "split": "ROCK_M", "score": {"player": "SELF_OWNER", "delta": 1}},
    {"event": "COLLIDE", "self": "SHOT", "other": "ROCK_M", "self_fate": "DESTROY",
     "other_fate": "SPLIT", "split": "ROCK_S", "score": {"player": "SELF_OWNER", "delta": 2}},
    {"event": "COLLIDE", "self": "SHOT", "other": "ROCK_S", "self_fate": "DESTROY",
     "other_fate": "DESTROY", "score": {"player": "SELF_OWNER", "delta": 3}},
    {"//": "an enemy shot hits a ship: 5 points to the shooter ...",
     "event": "COLLIDE", "self": "SHIP", "other": "SHOT", "owner_rel": "DIFFERENT",
     "other_fate": "DESTROY", "score": {"player": "OTHER_OWNER", "delta": 5}},
    {"//": "... and the ship loses a life and restarts, shielded and blinking for one second",
     "event": "COLLIDE", "self": "SHIP", "other": "SHOT", "owner_rel": "DIFFERENT",
     "self_fate": "RESPAWN", "score": {"player": "SELF_OWNER", "delta": -1, "counter": "LIVES"}},
    {"//": "a ship that rams a rock loses a life; the rock breaks as if shot",
     "event": "COLLIDE", "self": "SHIP", "other": "ROCK_L", "self_fate": "RESPAWN",
     "other_fate": "SPLIT", "split": "ROCK_M", "score": {"player": "SELF_OWNER", "delta": -1, "counter": "LIVES"}},
    {"event": "COLLIDE", "self": "SHIP", "other": "ROCK_M", "self_fate": "RESPAWN",
     "other_fate": "SPLIT", "split": "ROCK_S", "score": {"player": "SELF_OWNER", "delta": -1, "counter": "LIVES"}},
    {"event": "COLLIDE", "self": "SHIP", "other": "ROCK_S", "self_fate": "RESPAWN",
     "other_fate": "DESTROY", "score": {"player": "SELF_OWNER", "delta": -1, "counter": "LIVES"}}
  ]
